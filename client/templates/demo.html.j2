{% extends "base_app.html.j2" %}
{% block title %}Try it — GamerAI{% endblock %}
{% block extra_css %}
<link rel="stylesheet" href="/static/css/chat.css">
<style>
  .demo-banner {
    padding: .55rem 1rem; text-align: center; font-size: .85rem;
    color: var(--muted); background: #f7f9fc; border-bottom: 1px solid var(--border-soft);
  }
  .demo-banner a { color: var(--brand); }
  /* Same tool-row/voice-toggle markup as the real chat page, just
     disabled — the point is a visitor sees exactly what they'd get
     by signing up, not a hidden feature list. */
  .locked { opacity: .5; cursor: not-allowed !important; }
  .locked:hover { color: var(--muted) !important; }
  .lock-badge { font-size: .7rem; }
  .bubble.pending { color: var(--muted); font-style: italic; }
</style>
{% endblock %}

{% block brand_suffix %} — demo{% endblock %}
{% block topbar_actions %}
  <a href="https://github.com/Hyrumdrums/GamerAI" class="hide-mobile">GitHub</a>
  <a href="/download/" class="hide-mobile">download the agent</a>
  <a href="/login">sign in</a>
{% endblock %}

{% block content %}
<div class="demo-banner">
  No account, no install — canned sample replies, not a live model.
  <a href="/download/">Download the agent</a> to unlock everything below for real.
</div>
<div class="layout">
  <main class="main">
    <div class="chat-pane" id="chat-pane">
      <div class="empty" id="empty-state">
        <h2>What's on your mind?</h2>
        <div>Start a conversation by typing below.</div>
      </div>
    </div>

    <form class="composer" id="demo-form">
      <div class="tool-row">
        <label class="image-toggle locked" title="Sign up to unlock image generation">
          <input type="checkbox" disabled>
          <span>Generate as image <span class="lock-badge">🔒</span></span>
        </label>
        <label class="image-toggle locked" title="Sign up to unlock web search">
          <input type="checkbox" disabled>
          <span>Search the web <span class="lock-badge">🔒</span></span>
        </label>
        <label class="image-toggle locked" title="Sign up to unlock the 14B smart model">
          <input type="checkbox" disabled>
          <span>Smart mode <span class="lock-badge">🔒</span></span>
        </label>
      </div>
      <div class="composer-inner">
        <button type="button" class="voice-toggle locked" disabled
                title="Sign up to unlock read-aloud" aria-label="Read responses aloud (locked)">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4.03v8.05a4.5 4.5 0 0 0 2.5-4.02zM14 3.23v2.06A7 7 0 0 1 14 18.7v2.06A9 9 0 0 0 14 3.23z"/>
          </svg>
        </button>
        <textarea id="demo-prompt" placeholder="Message GamerAI..." rows="1" maxlength="2000"></textarea>
        <button type="submit" id="demo-send">Send</button>
      </div>
      <div class="status" id="demo-status"></div>
    </form>
  </main>
</div>

<script>
(function () {
  const pane = document.getElementById('chat-pane');
  let empty = document.getElementById('empty-state');
  const form = document.getElementById('demo-form');
  const input = document.getElementById('demo-prompt');
  const sendBtn = document.getElementById('demo-send');
  const status = document.getElementById('demo-status');

  function addBubble(text, role) {
    if (empty) { empty.remove(); empty = null; }
    const msg = document.createElement('div');
    msg.className = 'msg ' + role;
    const roleLabel = document.createElement('div');
    roleLabel.className = 'role';
    roleLabel.textContent = role === 'user' ? 'you' : 'gamerai';
    const bubble = document.createElement('div');
    bubble.className = 'bubble';
    if (role === 'assistant' && window.DOMPurify && window.marked) {
      bubble.innerHTML = DOMPurify.sanitize(marked.parse(text));
    } else {
      bubble.textContent = text;
    }
    msg.appendChild(roleLabel);
    msg.appendChild(bubble);
    pane.appendChild(msg);
    msg.scrollIntoView({ behavior: 'smooth', block: 'end' });
    return msg;
  }

  async function poll(jobId, pendingMsg) {
    const started = Date.now();
    while (Date.now() - started < 60000) {
      await new Promise((res) => setTimeout(res, 1000));
      let resp;
      try {
        resp = await fetch('/api/demo/result/' + encodeURIComponent(jobId));
      } catch (e) {
        continue; // transient network hiccup — keep polling within the deadline
      }
      if (!resp.ok) {
        pendingMsg.remove();
        status.textContent = 'That request failed (status ' + resp.status + ').';
        return;
      }
      const data = await resp.json();
      if (data.done) {
        pendingMsg.remove();
        if (data.status === 'error') {
          status.textContent = data.error || 'The demo worker reported an error.';
        } else {
          addBubble(data.text || '(empty response)', 'assistant');
        }
        return;
      }
    }
    pendingMsg.remove();
    status.textContent = 'Timed out waiting for a response. Please try again.';
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const prompt = input.value.trim();
    if (!prompt) return;
    status.textContent = '';
    addBubble(prompt, 'user');
    input.value = '';
    input.disabled = true;
    sendBtn.disabled = true;
    const pendingMsg = addBubble('…thinking…', 'assistant');
    pendingMsg.querySelector('.bubble').classList.add('pending');
    try {
      const resp = await fetch('/api/demo/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt }),
      });
      const data = await resp.json();
      if (!resp.ok) {
        pendingMsg.remove();
        status.textContent = data.detail || ('Request failed (status ' + resp.status + ').');
      } else {
        await poll(data.job_id, pendingMsg);
      }
    } catch (e) {
      pendingMsg.remove();
      status.textContent = 'Network error — please try again.';
    } finally {
      input.disabled = false;
      sendBtn.disabled = false;
      input.focus();
    }
  });

  input.addEventListener('keydown', (ev) => {
    if (ev.key === 'Enter' && !ev.shiftKey) {
      ev.preventDefault();
      form.requestSubmit();
    }
  });
})();
</script>
{% endblock %}

{% block extra_js %}
<script src="/static/marked.min.js"></script>
<script src="/static/purify.min.js"></script>
{% endblock %}

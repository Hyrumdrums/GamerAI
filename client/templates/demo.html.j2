{% extends "base.html.j2" %}
{% block title %}Try it — GamerAI{% endblock %}
{% block extra_css %}
<link rel="stylesheet" href="/static/css/redeem.css">
<style>
  #demo-log { display: flex; flex-direction: column; gap: .6rem; margin: 1rem 0; min-height: 2rem; }
  .demo-msg { border-radius: var(--radius); padding: .6rem .85rem; font-size: .95rem; white-space: pre-wrap; }
  .demo-msg.user { background: var(--brand, #1d4ed8); color: #fff; align-self: flex-end; max-width: 80%; }
  .demo-msg.assistant { background: #f2f2f2; align-self: flex-start; max-width: 80%; }
  .demo-msg.pending { color: var(--muted); font-style: italic; }
  #demo-form { display: flex; gap: .5rem; }
  #demo-prompt { flex: 1; }
</style>
{% endblock %}

{% block content %}
<div class="page">
  <h1>Try GamerAI</h1>
  <div class="muted" style="margin-bottom:1.25rem">
    No account, no install — this is a rate-limited preview of the chat
    tool, served by the community network's smallest model. Contributors
    running the agent get the full toolbox and a much bigger daily
    allowance. <a href="/download/">Download the agent</a> to join for real.
  </div>

  <div class="card">
    <div id="demo-log"></div>
    <form id="demo-form">
      <input id="demo-prompt" type="text" placeholder="Ask something…"
             maxlength="2000" autocomplete="off" required autofocus>
      <button type="submit" id="demo-send">Send</button>
    </form>
    <div id="demo-error" class="alert-err" style="display:none"></div>
  </div>
</div>

<script>
(function () {
  const log = document.getElementById('demo-log');
  const form = document.getElementById('demo-form');
  const input = document.getElementById('demo-prompt');
  const sendBtn = document.getElementById('demo-send');
  const errBox = document.getElementById('demo-error');

  function addBubble(text, cls) {
    const el = document.createElement('div');
    el.className = 'demo-msg ' + cls;
    el.textContent = text;
    log.appendChild(el);
    el.scrollIntoView({ behavior: 'smooth', block: 'end' });
    return el;
  }

  function showError(msg) {
    errBox.textContent = msg;
    errBox.style.display = 'block';
  }

  async function poll(jobId, pendingEl) {
    const started = Date.now();
    while (Date.now() - started < 60000) {
      await new Promise((res) => setTimeout(res, 1000));
      let resp;
      try {
        resp = await fetch('/api/demo/result/' + encodeURIComponent(jobId));
      } catch (e) {
        continue; // transient network hiccup — keep polling within the deadline
      }
      if (!resp.ok) {
        pendingEl.remove();
        showError('That request failed (status ' + resp.status + ').');
        return;
      }
      const data = await resp.json();
      if (data.done) {
        pendingEl.remove();
        if (data.status === 'error') {
          showError(data.error || 'The demo worker reported an error.');
        } else {
          addBubble(data.text || '(empty response)', 'assistant');
        }
        return;
      }
    }
    pendingEl.remove();
    showError('Timed out waiting for a response. Please try again.');
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const prompt = input.value.trim();
    if (!prompt) return;
    errBox.style.display = 'none';
    addBubble(prompt, 'user');
    input.value = '';
    input.disabled = true;
    sendBtn.disabled = true;
    const pendingEl = addBubble('…thinking…', 'assistant pending');
    try {
      const resp = await fetch('/api/demo/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt }),
      });
      const data = await resp.json();
      if (!resp.ok) {
        pendingEl.remove();
        showError(data.detail || ('Request failed (status ' + resp.status + ').'));
      } else {
        await poll(data.job_id, pendingEl);
      }
    } catch (e) {
      pendingEl.remove();
      showError('Network error — please try again.');
    } finally {
      input.disabled = false;
      sendBtn.disabled = false;
      input.focus();
    }
  });
})();
</script>
{% endblock %}

{% extends "base_app.html.j2" %}
{% block title %}Try it — GamerAI{% endblock %}
{% block extra_css %}
<link rel="stylesheet" href="/static/css/chat.css">
<style>
  .demo-banner {
    padding: .55rem 1rem; text-align: center; font-size: .85rem;
    color: var(--muted); background: #f7f9fc; border-bottom: 1px solid var(--border-soft);
  }
  .demo-banner a { color: var(--brand); }
  /* Same tool-row/voice-toggle markup as the real chat page, just
     disabled — the point is a visitor sees exactly what they'd get
     by signing up, not a hidden feature list. */
  .locked { opacity: .5; cursor: not-allowed !important; }
  .locked:hover { color: var(--muted) !important; }
  .lock-badge { font-size: .7rem; }
  .bubble.pending { color: var(--muted); font-style: italic; }
</style>
{% endblock %}

{% block brand_suffix %} — demo{% endblock %}
{% block topbar_actions %}
  <a href="https://github.com/Hyrumdrums/GamerAI" class="hide-mobile">GitHub</a>
  <a href="/download/" class="hide-mobile">download the agent</a>
  <a href="/login">sign in</a>
{% endblock %}

{% block content %}
<div class="demo-banner">
  No account, no install — canned sample replies, not a live model.
  <a href="/download/">Download the agent</a> to unlock everything below for real.
</div>
<div class="layout">
  <main class="main">
    <div class="chat-pane" id="chat-pane">
      <div class="empty" id="empty-state">
        <h2>What's on your mind?</h2>
        <div>Start a conversation by typing below.</div>
      </div>
    </div>

    <form class="composer" id="demo-form">
      <div class="tool-row">
        <label class="image-toggle locked" title="Sign up to unlock image generation">
          <input type="checkbox" disabled>
          <span>Generate as image <span class="lock-badge">🔒</span></span>
        </label>
        <label class="image-toggle locked" title="Sign up to unlock web search">
          <input type="checkbox" disabled>
          <span>Search the web <span class="lock-badge">🔒</span></span>
        </label>
        <label class="image-toggle locked" title="Sign up to unlock the 14B smart model">
          <input type="checkbox" disabled>
          <span>Smart mode <span class="lock-badge">🔒</span></span>
        </label>
      </div>
      <div class="composer-inner">
        <button type="button" class="voice-toggle locked" disabled
                title="Sign up to unlock read-aloud" aria-label="Read responses aloud (locked)">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4.03v8.05a4.5 4.5 0 0 0 2.5-4.02zM14 3.23v2.06A7 7 0 0 1 14 18.7v2.06A9 9 0 0 0 14 3.23z"/>
          </svg>
        </button>
        <textarea id="demo-prompt" placeholder="Message GamerAI..." rows="1" maxlength="2000"></textarea>
        <button type="submit" id="demo-send">Send</button>
      </div>
      <div class="status" id="demo-status"></div>
    </form>
  </main>
</div>

<script>
(function () {
  const pane = document.getElementById('chat-pane');
  let empty = document.getElementById('empty-state');
  const form = document.getElementById('demo-form');
  const input = document.getElementById('demo-prompt');
  const sendBtn = document.getElementById('demo-send');
  const status = document.getElementById('demo-status');

  // Entirely client-side — no request ever leaves the browser. A
  // public, no-account page is bot bait; hand-picking a canned line
  // from this list costs nothing no matter how much traffic it gets,
  // and it means the banner above ("canned sample replies, not a live
  // model") is literally true rather than aspirational.
  const CANNED_REPLIES = [
    "This is a demo screen, not a live model — just one of a handful of scripted replies. The real thing can also **generate images** right in the chat. Download the agent to try it for real.",
    "Canned response here, no model behind it. On the real network you can flip on **web search** and I'll cite live sources in the answer.",
    "Just a scripted line — this page never calls the network. Real members can enable **Smart Mode**, which routes to a much larger 14B-parameter model for harder questions.",
    "This reply is fixed text, not a generated one. On the full app, conversations are saved, so I actually remember what we talked about five minutes ago.",
    "Demo mode: canned text, zero GPU cycles spent. The real GamerAI runs entirely on volunteers' gaming PCs — no subscription, and nobody trains on your prompts.",
    "No model wrote this — it's one of a handful of scripted demo lines. The real app can **read responses aloud**; tap the speaker icon on any message.",
    "Static placeholder text, not a real answer. Running the agent on your own PC earns you a higher daily quota — the more you contribute, the more you get back.",
    "This is a demo reply picked at random, not a response to what you actually asked. Download the agent and every message after that runs on a real model, not a script.",
    "Nothing but scripted text so far — this page makes no network calls at all. The real app supports multi-turn conversations, image generation, live web search, and read-aloud, all in one place.",
    "Canned demo output — no inference happened. Contributors keep the network running by sharing spare GPU time; in return, everyone on their invite tree gets free access to the whole toolbox.",
  ];
  let lastIndex = -1;
  function pickReply() {
    if (CANNED_REPLIES.length === 1) return CANNED_REPLIES[0];
    let i;
    do { i = Math.floor(Math.random() * CANNED_REPLIES.length); } while (i === lastIndex);
    lastIndex = i;
    return CANNED_REPLIES[i];
  }

  function addBubble(text, role) {
    if (empty) { empty.remove(); empty = null; }
    const msg = document.createElement('div');
    msg.className = 'msg ' + role;
    const roleLabel = document.createElement('div');
    roleLabel.className = 'role';
    roleLabel.textContent = role === 'user' ? 'you' : 'gamerai';
    const bubble = document.createElement('div');
    bubble.className = 'bubble';
    if (role === 'assistant' && window.DOMPurify && window.marked) {
      bubble.innerHTML = DOMPurify.sanitize(marked.parse(text));
    } else {
      bubble.textContent = text;
    }
    msg.appendChild(roleLabel);
    msg.appendChild(bubble);
    pane.appendChild(msg);
    msg.scrollIntoView({ behavior: 'smooth', block: 'end' });
    return msg;
  }

  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const prompt = input.value.trim();
    if (!prompt) return;
    status.textContent = '';
    addBubble(prompt, 'user');
    input.value = '';
    input.disabled = true;
    sendBtn.disabled = true;
    const pendingMsg = addBubble('…thinking…', 'assistant');
    pendingMsg.querySelector('.bubble').classList.add('pending');
    // Small random delay so the reply doesn't pop in instantly — makes
    // the "thinking" state read as intentional rather than broken.
    const delay = 500 + Math.random() * 700;
    setTimeout(() => {
      pendingMsg.remove();
      addBubble(pickReply(), 'assistant');
      input.disabled = false;
      sendBtn.disabled = false;
      input.focus();
    }, delay);
  });

  input.addEventListener('keydown', (ev) => {
    if (ev.key === 'Enter' && !ev.shiftKey) {
      ev.preventDefault();
      form.requestSubmit();
    }
  });
})();
</script>
{% endblock %}

{% block extra_js %}
<script src="/static/marked.min.js"></script>
<script src="/static/purify.min.js"></script>
{% endblock %}

{% extends "base.html.j2" %}
{% block title %}Account — GamerAI{% endblock %}
{% block extra_css %}
<link rel="stylesheet" href="/static/css/account.css">
{% endblock %}

{% block topbar %}
<div class="topbar">
  <div class="brand">GamerAI · account</div>
  <div class="topbar-actions">
    <a href="/" class="hide-mobile">← chat</a>
    {% if me.role == 'admin' %}
    <a href="/dashboard" class="hide-mobile">admin</a>
    {% endif %}
    <a href="/logout">sign out</a>
  </div>
</div>
{% endblock %}

{% block content %}
<div class="page">
  {% if flash %}
  <div class="flash">{{ flash }}</div>
  {% endif %}

  <section class="card">
    <h1>Account</h1>
    <div class="kv">
      <div class="k">Username</div>
      <div class="v">{{ me.username or '(not set)' }}</div>
      <div class="k">Email</div>
      <div class="v">{{ me.email or '(none)' }}</div>
      <div class="k">Role</div>
      <div class="v">{{ me.role }}</div>
      <div class="k">Tier</div>
      <div class="v">{{ me.tier }}</div>
      <div class="k">Daily cap (chat)</div>
      <div class="v">
        {% if me.daily_quota_tokens is not none %}
          {{ "{:,}".format(me.daily_quota_tokens) }} tokens/day
        {% else %}
          unlimited
        {% endif %}
      </div>
      <div class="k">Daily cap (images)</div>
      <div class="v">
        {% if me.daily_quota_images is not none %}
          {{ me.daily_quota_images }} images/day
        {% else %}
          unlimited
        {% endif %}
      </div>
    </div>

    <h2>Change password</h2>
    <form method="POST" action="/account/password" class="stacked">
      {% if me.has_password %}
      <label class="label" for="current_password">Current password</label>
      <input id="current_password" name="current_password" type="password"
             autocomplete="current-password" required>
      {% else %}
      <input type="hidden" name="current_password" value="">
      <div class="muted">You don't have a password set yet — pick one below
        and you'll be able to sign in with your username from now on.</div>
      {% endif %}

      <label class="label" for="new_password">New password</label>
      <input id="new_password" name="new_password" type="password"
             autocomplete="new-password" minlength="8" required>

      <label class="label" for="new_password_confirm">Confirm new password</label>
      <input id="new_password_confirm" name="new_password_confirm" type="password"
             autocomplete="new-password" minlength="8" required>

      <button type="submit">Update password</button>
    </form>
  </section>

  {% if contrib_status and contrib_status.get('engine_applies') %}
  <section class="card">
    <h2>Contribution status</h2>
    {% set req = contrib_status.current_tier_requirements %}
    {% set up = contrib_status.uptime_7d %}
    <p class="muted">
      Your tier is set by a daily promote/demote engine. It looks at
      the last 7 days of uptime across your registered workers.
      Promotions are immediate when you meet the next tier's bar;
      demotions wait 14 days of continuous underperformance so a
      single vacation week won't drop you.
    </p>
    <div class="kv">
      <div class="k">Current tier</div>
      <div class="v">
        {{ contrib_status.tier }}
        {% if contrib_status.meets_current %}
        <span class="badge badge-ok">meeting bar</span>
        {% else %}
        <span class="badge badge-warn">below bar</span>
        {% endif %}
      </div>
      <div class="k">7-day uptime</div>
      <div class="v">
        {{ up.days_online }} of 7 days online ·
        avg {{ up.avg_hours_per_active_day }} hr/active day
      </div>
      <div class="k">Current tier needs</div>
      <div class="v">
        ≥ {{ req.min_hours_per_day }} hr/day · ≥
        {{ req.min_days_per_week }} days/week
      </div>
      {% if contrib_status.next_tier %}
      {% set nreq = contrib_status.next_tier_requirements %}
      <div class="k">Next tier ({{ contrib_status.next_tier }})</div>
      <div class="v">
        ≥ {{ nreq.min_hours_per_day }} hr/day · ≥
        {{ nreq.min_days_per_week }} days/week
        {% if contrib_status.meets_next %}
        <span class="badge badge-ok">eligible — promoting on next nightly run</span>
        {% endif %}
      </div>
      {% else %}
      <div class="k">Next tier</div>
      <div class="v">You're at the top of the ladder.</div>
      {% endif %}
    </div>
    {% if not contrib_status.meets_current and contrib_status.previous_tier %}
    <p class="muted partial-warn">
      <strong>You're below the {{ contrib_status.tier }} bar.</strong>
      {% if contrib_status.tier_below_threshold_since %}
      If this continues for 14 days you'll drop to
      {{ contrib_status.previous_tier }}. Get back above the bar to
      reset the countdown.
      {% else %}
      The countdown starts tomorrow — get back above the bar today
      to avoid it.
      {% endif %}
    </p>
    {% endif %}
  </section>
  {% endif %}

  <section class="card">
    <h2>Your activity</h2>
    <p class="muted">
      One member, two ledgers. <strong>Used today</strong> is what you
      consumed; <strong>earned</strong> is what your paired machines
      contributed. They're independent — running an agent doesn't
      offset your own usage, it earns you the tier that sets the cap.
    </p>
    <div class="kv">
      <div class="k">Used today (chat)</div>
      <div class="v">
        {{ "{:,}".format(usage_today.get('tokens_out', 0)) }} tokens
        {% if me.daily_quota_tokens %}
          / {{ "{:,}".format(me.daily_quota_tokens) }}
        {% endif %}
      </div>
      <div class="k">Used today (images)</div>
      <div class="v">
        {{ "%g"|format(usage_today.get('image_units', 0)) }} images
        {% if me.daily_quota_images %}
          / {{ me.daily_quota_images }}
        {% endif %}
      </div>
      <div class="k">Earned (lifetime)</div>
      <div class="v">
        ${{ "%.4f"|format(earnings.get('total_usd', 0)) }}
        across {{ earnings.get('machine_count', 0) }} machine{% if earnings.get('machine_count', 0) != 1 %}s{% endif %}
        ({{ earnings.get('total_jobs', 0) }} jobs)
      </div>
    </div>
    {% if partial_contributor_count and partial_contributor_count > 0 %}
    <p class="muted partial-warn">
      <strong>{{ partial_contributor_count }} of your machine{% if partial_contributor_count != 1 %}s are{% else %} is{% endif %} chat-only.</strong>
      Image generation is unavailable on {% if partial_contributor_count != 1 %}them{% else %}it{% endif %}, so
      {% if partial_contributor_count != 1 %}they{% else %}it{% endif %} count{% if partial_contributor_count == 1 %}s{% endif %} as a partial
      contributor. Reinstall the agent with the image model to upgrade.
    </p>
    {% endif %}
  </section>

  {% if me.host %}
  <section class="card">
    <h2>Your host</h2>
    <div class="kv">
      <div class="k">Username</div>
      <div class="v">{{ me.host.username or '(none)' }}</div>
      <div class="k">Email</div>
      <div class="v">{{ me.host.email or '(not shared)' }}</div>
      <div class="k">Tier</div>
      <div class="v">{{ me.host.tier }}</div>
    </div>
    <p class="muted">
      Your host vouched for you on the network. They can adjust your
      daily cap or revoke your access. Email-based password reset is on
      hold until we wire up an email service — for now, pick a password
      you'll remember.
    </p>
  </section>
  {% endif %}

  <section class="card">
    <h2>Friends</h2>
    {% if can_invite %}
    <p class="muted">People you've invited. Copy an open invite link to
      share with someone over your preferred channel — we don't send
      emails yet.</p>

    <form method="POST" action="/account/invites" class="inline-form"
          data-tier="{{ me.tier }}"
          {% if tier_quota_tokens is not none %}
          data-tier-tokens="{{ tier_quota_tokens }}"
          {% endif %}
          {% if tier_quota_images is not none %}
          data-tier-images="{{ tier_quota_images }}"
          {% endif %}>
      <label class="label" for="invitee_email">Friend's email</label>
      <input id="invitee_email" name="invitee_email" type="email"
             placeholder="friend@example.com" required>

      <label class="label" for="daily_quota_tokens">
        Daily cap (tokens; blank = unlimited)
        {% if tier_quota_tokens is not none %}
        <span class="muted">— your {{ me.tier }} allowance is
          {{ "{:,}".format(tier_quota_tokens) }}/day</span>
        {% endif %}
      </label>
      <div class="input-with-tip">
        <input id="daily_quota_tokens" name="daily_quota_tokens"
               type="number" min="0">
        <span class="invite-tip" id="daily_quota_tokens_tip"></span>
      </div>

      <label class="label" for="daily_quota_images">
        Daily cap (images; blank = unlimited)
        {% if tier_quota_images is not none %}
        <span class="muted">— your {{ me.tier }} allowance is
          {{ tier_quota_images }}/day</span>
        {% endif %}
      </label>
      <div class="input-with-tip">
        <input id="daily_quota_images" name="daily_quota_images"
               type="number" min="0">
        <span class="invite-tip" id="daily_quota_images_tip"></span>
      </div>

      <label class="label" for="expires_hours">Expires in (hours; blank = never)</label>
      <input id="expires_hours" name="expires_hours" type="number" min="0" step="0.5">
      <button type="submit">Create invite</button>
    </form>

    {% if friends.open_invites %}
    <h3>Open invites</h3>
    <table class="friends-table">
      <thead>
        <tr><th>For</th><th>Chat cap</th><th>Image cap</th><th>State</th><th>Link</th><th></th></tr>
      </thead>
      <tbody>
        {% for inv in friends.open_invites %}
        <tr>
          <td>{{ inv.invitee_email or '—' }}</td>
          <td>{% if inv.daily_quota_tokens is not none %}{{ "{:,}".format(inv.daily_quota_tokens) }}{% else %}∞{% endif %}</td>
          <td>{% if inv.daily_quota_images is not none %}{{ inv.daily_quota_images }}{% else %}∞{% endif %}</td>
          <td>{{ inv.state }}</td>
          <td>
            <button class="copy-link" type="button"
                    data-href="/invite/{{ inv.code }}">copy link</button>
          </td>
          <td>
            {% if inv.state == 'open' %}
            <form method="POST" action="/account/invites/{{ inv.code }}/revoke" class="inline">
              <button type="submit" class="danger">revoke</button>
            </form>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {% if friends.accepted %}
    <h3>Accepted invitees</h3>
    <p class="muted">Edit each friend's caps inline, or revoke if they
      signed up for a higher tier than their machine is delivering.
      "Last seen" shows when they last touched the API.</p>
    <table class="friends-table friends-editable">
      <thead>
        <tr>
          <th>Username</th>
          <th>Chat cap</th>
          <th>Image cap</th>
          <th>Tier</th>
          <th>Last seen</th>
          <th>State</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for f in friends.accepted %}
        <tr>
          <td>
            {{ f.username or '(no username)' }}
            <div class="muted small">{{ f.email or '—' }}</div>
          </td>
          {% if f.revoked_at %}
          <td>{% if f.daily_quota_tokens is not none %}{{ "{:,}".format(f.daily_quota_tokens) }}{% else %}∞{% endif %}</td>
          <td>{% if f.daily_quota_images is not none %}{{ f.daily_quota_images }}{% else %}∞{% endif %}</td>
          {% else %}
          <td colspan="2">
            <form method="POST"
                  action="/account/friends/{{ f.member_id }}/quota"
                  class="inline friend-quota-form">
              <input type="number" min="0" step="1"
                     name="daily_quota_tokens"
                     placeholder="∞"
                     value="{% if f.daily_quota_tokens is not none %}{{ f.daily_quota_tokens }}{% endif %}"
                     aria-label="daily token cap" title="daily tokens">
              <span class="qsep">tok ·</span>
              <input type="number" min="0" step="1"
                     name="daily_quota_images"
                     placeholder="∞"
                     value="{% if f.daily_quota_images is not none %}{{ f.daily_quota_images }}{% endif %}"
                     aria-label="daily image cap" title="daily images">
              <span class="qsep">img</span>
              <button type="submit">save</button>
            </form>
          </td>
          {% endif %}
          <td>{{ f.tier }}</td>
          <td>
            {% if f.last_active_at %}
            <span title="{{ f.last_active_at }}">
              {{ ((f.last_active_at | int) | string)[:10] }}
            </span>
            {% else %}
            <span class="muted">never</span>
            {% endif %}
          </td>
          <td>
            {% if f.revoked_at %}
            <span class="badge badge-revoked">revoked</span>
            {% else %}
            <span>active</span>
            {% endif %}
          </td>
          <td>
            {% if not f.revoked_at %}
            <form method="POST"
                  action="/account/friends/{{ f.member_id }}/revoke"
                  class="inline"
                  onsubmit="return confirm('Revoke {{ f.username or f.email or 'this friend' }}? Their token stops working immediately.');">
              <button type="submit" class="danger">revoke</button>
            </form>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {% if not friends.open_invites and not friends.accepted %}
    <p class="muted">No invites yet. Use the form above to send one.</p>
    {% endif %}
    {% else %}
    <p class="muted">
      Inviting friends is a host privilege. Run a GamerAI agent to
      become a host and unlock invite slots when the tier engine ships
      (Phase 3b.i — see roadmap).
    </p>
    {% endif %}
  </section>

  <section class="card">
    <h2>Paired machines</h2>
    {% if machines %}
    <p class="muted">PCs running a GamerAI agent under this account.
      Unpair revokes the agent's credential server-side immediately —
      the next heartbeat from that machine will 401.</p>
    <table class="friends-table">
      <thead>
        <tr><th>Label</th><th>Paired</th><th>Last used</th><th></th></tr>
      </thead>
      <tbody>
        {% for m in machines %}
        <tr>
          <td>{{ m.label }}</td>
          <td>
            {% if m.created_at %}
            <span title="{{ m.created_at }}">
              {{ ((m.created_at | int) | string)[:10] }}
            </span>
            {% else %}—{% endif %}
          </td>
          <td>
            {% if m.last_used_at %}
            <span title="{{ m.last_used_at }}">recent</span>
            {% else %}
            never
            {% endif %}
          </td>
          <td>
            <form method="POST" action="/account/machines/{{ m.id }}/unpair" class="inline">
              <button type="submit" class="danger">unpair</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if owned_workers %}
    <h3>Registered workers</h3>
    <p class="muted">What your machines advertise to the network.
      Chat-only workers count as <strong>partial contributors</strong> —
      install the image model to upgrade. Use <em>forget</em> to clear
      a stale registration after a PC rebuild.</p>
    <table class="friends-table">
      <thead>
        <tr>
          <th>Worker</th>
          <th>Status</th>
          <th>Tools</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for w in owned_workers %}
        <tr>
          <td>{{ w.worker_id }}</td>
          <td>{{ w.status }}</td>
          <td>
            {% if w.is_partial %}
            <span class="badge badge-partial" title="image generation unavailable">
              partial — no image
            </span>
            {% else %}
            {{ w.tools | join(', ') }}
            {% endif %}
          </td>
          <td>
            <form method="POST"
                  action="/account/workers/{{ w.worker_id }}/forget"
                  class="inline"
                  onsubmit="return confirm('Forget {{ w.worker_id }}? Lifetime earnings stay, but the row disappears from this page.');">
              <button type="submit" class="danger">forget</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if hidden_stale_count and hidden_stale_count > 0 %}
    <p class="muted small">
      {{ hidden_stale_count }} more worker{% if hidden_stale_count != 1 %}s{% endif %}
      offline for 30+ days {% if hidden_stale_count != 1 %}are{% else %}is{% endif %}
      hidden. Earnings history is preserved.
    </p>
    {% endif %}
    {% endif %}
    {% else %}
    <p class="muted">
      No paired PCs yet.
      <a href="/contribute">Run an agent on a Windows PC</a> to
      contribute to the network and lift your tier.
    </p>
    {% endif %}
  </section>

  <section class="card cta">
    <h2>Want to invite more friends?</h2>
    <p>
      Running an agent on more PCs raises your tier and unlocks more
      invite slots for you and the people you've already brought on.
      Same five-minute Windows install whether it's your first PC or
      your fifth.
    </p>
    <p>
      <a class="btn" href="/contribute">Contribute and invite friends</a>
    </p>
  </section>
</div>
{% endblock %}

{% block extra_js %}
<script src="/static/js/account.js"></script>
{% endblock %}

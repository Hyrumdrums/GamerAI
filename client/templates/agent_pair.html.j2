{% extends "base_app.html.j2" %}
{% block title %}Pair this PC — GamerAI{% endblock %}
{% block extra_css %}
<link rel="stylesheet" href="/static/css/account.css">
{% endblock %}

{% block brand_suffix %} · pair{% endblock %}
{% block topbar_actions %}
    <a href="/account" class="hide-mobile">← account</a>
    <a href="/logout">sign out</a>
{% endblock %}

{% block content %}
<div class="page">
  <section class="card">
    {% if state == 'enter' %}
    <h1>Pair this PC with your account</h1>
    <p>
      A GamerAI agent wants to sign in as
      <strong>{{ me.username or me.email or me.member_id }}</strong> so it
      can serve jobs and contribute uptime under your account.
    </p>
    <p class="muted">
      Type the code shown in your agent's window to approve. The code
      appears <em>only</em> on the PC running the agent — never enter a
      code someone sent you in a link or message, even if it points here.
      It's valid for 5 minutes and pairs exactly one agent.
    </p>
    {% if error_detail %}
    <p class="error">{{ error_detail }}</p>
    {% endif %}
    <form method="POST" action="/agent/pair">
      <input type="text" name="user_code" inputmode="text"
             placeholder="XXXX-XXXX" autocomplete="off"
             autocapitalize="characters" spellcheck="false"
             aria-label="Pairing code from your agent window"
             value="{{ user_code or '' }}" required>
      <button type="submit">Pair this PC</button>
    </form>

    {% elif state == 'confirmed' %}
    <h1>Paired</h1>
    <p>
      The agent on your PC will pick up its credentials in a moment.
      Leave it running and head back to
      <a href="/">the chat page</a> — it'll start serving jobs from
      the network as soon as the machine is idle.
    </p>

    {% elif state == 'expired' %}
    <h1>That code didn't work</h1>
    <p>
      It may have expired (codes last 5 minutes) or already been used.
      On the PC running the agent, run <code>agent pair</code> again to
      get a fresh code, then enter it here.
    </p>
    {% if error_detail %}
    <p class="muted">Server detail: {{ error_detail }}</p>
    {% endif %}

    {% else %}
    <h1>Something went wrong</h1>
    <p class="muted">{{ error_detail or 'Unknown state: ' ~ state }}</p>
    {% endif %}
  </section>
</div>
{% endblock %}

{% extends "base_app.html.j2" %}
{% block title %}GamerAI Admin Dashboard{% endblock %}
{% block extra_css %}
<link rel="stylesheet" href="/static/css/dashboard.css">
{% endblock %}

{% block brand_suffix %} · admin{% endblock %}
{% block topbar_actions %}
    <button onclick="location.reload()" class="btn-quiet" style="width:auto">Refresh</button>
    <a href="/">← chat</a>
{% endblock %}

{% block content %}
<div class="page">
  <div class="stats">
    <div class="stat-card">
      <div class="stat-value">{{ workers|length }}</div>
      <div class="stat-label">Total Workers</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{{ active_workers_count }}</div>
      <div class="stat-label">Online Workers</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{{ metrics.get('total_jobs', 0) }}</div>
      <div class="stat-label">Jobs Processed</div>
    </div>
  </div>

  <div class="row-2">
    <div class="section">
      <h2>System Metrics</h2>
      <table>
        <tr><th>Metric</th><th>Value</th></tr>
        {% for k, v in metrics.items() %}
        <tr><td>{{ k }}</td><td>{{ v }}</td></tr>
        {% endfor %}
      </table>
    </div>
  </div>

  <div class="section">
    <h2>Email delivery test</h2>
    <p class="muted">
      Send a one-off test message via Resend to confirm delivery is
      working (domain/DNS verification, API key) without creating a
      throwaway signup just to trigger an email.
    </p>
    {% if test_email_msg %}
    <div class="{% if test_email_ok == '1' %}test-email-ok{% else %}alert-err{% endif %}">
      {{ test_email_msg }}
    </div>
    {% endif %}
    <form method="POST" action="/admin/test-email" class="inline-form">
      <input type="email" name="to" placeholder="you@example.com" required>
      <button type="submit">Send test email</button>
    </form>
  </div>

  <div class="section">
    <h2>All Workers</h2>
    <table>
      <tr><th>Worker ID</th><th>Account</th><th>GPU</th><th>Status</th><th>Jobs</th><th>Tokens</th><th>Last Active</th></tr>
      {% for x in workers %}
      <tr>
        <td>
          <span style="color:{% if x.status != 'offline' %}#4CAF50{% else %}#FF5722{% endif %};">●</span>
          <a href="/admin/jobs?worker_id={{ x.worker_id }}">{{ x.worker_id[-12:] }}</a>
        </td>
        <td>
          {% if x.owner_member_id %}
            <a href="/admin/jobs?member_id={{ x.owner_member_id }}">{{ x.owner_label or '—' }}</a>
          {% else %}—{% endif %}
        </td>
        <td>
          {% if x.capabilities and x.capabilities.gpu_model %}
            {{ x.capabilities.gpu_model }}{% if x.capabilities.vram_gb %} ({{ x.capabilities.vram_gb }} GB){% endif %}
          {% else %}—{% endif %}
        </td>
        <td>{{ x.status }}</td>
        <td>{{ x.total_jobs }}</td>
        <td>{{ x.total_tokens }}</td>
        <td>{{ x.last_seen | epoch_date }}</td>
      </tr>
      {% endfor %}
    </table>
  </div>
</div>
{% endblock %}

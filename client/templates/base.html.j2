<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{% block title %}GamerAI{% endblock %}</title>
  <link rel="stylesheet" href="/static/css/base.css">

  <!-- PWA: manifest + icons + theme. iOS Safari ignores the manifest's
       theme_color / app title / status-bar style, so the apple-* meta
       tags below are required to get a real installed-PWA experience
       on iPhone (per PWA_REFERENCE §2 + §8). format-detection prevents
       Safari from auto-linking phone numbers / emails in chat text. -->
  <link rel="manifest" href="/static/manifest.webmanifest">
  <link rel="icon" href="/static/icons/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="192x192" href="/static/icons/icon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/static/icons/icon-512.png">
  <link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png">
  <meta name="theme-color" content="#1d4ed8">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="GamerAI">
  <meta name="format-detection" content="telephone=no,email=no">

  {% block extra_css %}{% endblock %}
</head>
<body>
{% block topbar %}{% endblock %}
{% block content %}{% endblock %}
{% block extra_js %}{% endblock %}
<script>
  // Service worker registration. Browsers only allow SWs over HTTPS
  // (or localhost for dev), so this is a no-op on plain http://
  // origins — the API check + the secure-context check below mean we
  // never throw on the public bits of the app. Registered with explicit
  // scope: '/' so the SW (served from /sw.js) can intercept navigations
  // to every path on the origin.
  if ('serviceWorker' in navigator && window.isSecureContext) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js', { scope: '/' })
        .then((reg) => {
          // The browser's own update check is heavily throttled — a
          // backgrounded tab or a home-screen PWA reopened days later
          // can sit on a stale SW indefinitely with no signal to the
          // user. Force a check on load, on refocus, and on a slow
          // timer, then surface it instead of leaving them silently
          // stale (this is what a fresh deploy needs to actually reach
          // an already-installed client).
          reg.update().catch(() => {});
          document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') reg.update().catch(() => {});
          });
          setInterval(() => reg.update().catch(() => {}), 20 * 60 * 1000);

          reg.addEventListener('updatefound', () => {
            const installing = reg.installing;
            if (!installing) return;
            installing.addEventListener('statechange', () => {
              // installed + an already-existing controller means this
              // replaced a previously-active SW (a real update).
              // installed with no controller yet is just the first-ever
              // install for this browser — nothing to prompt about.
              if (installing.state === 'installed' && navigator.serviceWorker.controller) {
                showUpdateBanner();
              }
            });
          });
        })
        .catch((err) => console.warn('SW registration failed', err));
    });
  }

  function showUpdateBanner() {
    if (document.querySelector('.pwa-banner.update')) return;
    const banner = document.createElement('div');
    banner.className = 'pwa-banner update';
    banner.innerHTML = `
      <span class="pwa-banner-text">A new version of GamerAI is ready.</span>
      <button type="button" class="pwa-banner-action">Refresh</button>
      <button type="button" class="pwa-banner-dismiss" aria-label="Not now">Not now</button>
    `;
    document.body.appendChild(banner);
    banner.querySelector('.pwa-banner-action').onclick = () => window.location.reload();
    banner.querySelector('.pwa-banner-dismiss').onclick = () => banner.remove();
  }
</script>
</body>
</html>

{% extends "base.html.j2" %}
{% block title %}GamerAI{% endblock %}
{% block extra_css %}
<link rel="stylesheet" href="/static/css/chat.css">
{% endblock %}

{% block topbar %}
<div class="topbar">
  <div style="display:flex;align-items:center;gap:.6rem">
    <button class="hamburger" id="hamburger" type="button" aria-label="Toggle conversations">☰</button>
    <div class="brand-stack">
      <div class="brand">GamerAI</div>
      <div class="brand-version" title="PWA shell cache version (single source of truth in shared/config.py)">v1.0.{{ cache_version }}</div>
    </div>
    <a id="contributelink" href="/contribute" class="contribute-cta" hidden>
      <span class="hide-mobile">Contribute and invite friends</span>
      <span class="hide-desktop">Invite friends</span>
    </a>
  </div>
  <div class="topbar-actions">
    <a id="who" href="/account">signing in…</a>
    <a href="/tos" target="_blank" class="hide-mobile">terms</a>
    <a id="adminlink" href="/dashboard" class="hide-mobile" hidden>admin</a>
    <a href="/logout">sign out</a>
  </div>
</div>
{% endblock %}

{% block content %}
<div class="layout">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-head">
      <button id="new-chat">+ New chat</button>
    </div>
    <div class="conv-list" id="conv-list"></div>
  </aside>

  <main class="main">
    <div class="chat-pane" id="chat-pane">
      <div class="empty" id="empty-state">
        <h2>What's on your mind?</h2>
        <div>Start a new conversation by typing below.</div>
      </div>
    </div>

    <form class="composer" id="composer">
      <div class="tool-row">
        <label class="image-toggle" id="image-toggle-wrap">
          <input type="checkbox" id="tool-image-cb">
          <span>Generate as image</span>
        </label>
        <div class="image-size" id="image-size-wrap" hidden>
          <label><input type="radio" name="image-size" value="small" checked> Small <em>1×</em></label>
          <label><input type="radio" name="image-size" value="medium"> Medium <em>2×</em></label>
          <label><input type="radio" name="image-size" value="large"> Large <em>4×</em></label>
        </div>
        <label class="image-toggle" id="search-toggle-wrap">
          <input type="checkbox" id="tool-search-cb">
          <span>Search the web</span>
        </label>
        <div class="search-mode" id="search-mode-wrap" hidden>
          <label><input type="radio" name="search-mode" value="fast" checked> Fast</label>
          <label><input type="radio" name="search-mode" value="comprehensive"> Comprehensive</label>
        </div>
      </div>
      <div class="composer-inner">
        <button
          type="button"
          id="voice-toggle"
          class="voice-toggle"
          aria-pressed="false"
          aria-label="Read responses aloud"
          title="Read responses aloud">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4.03v8.05a4.5 4.5 0 0 0 2.5-4.02zM14 3.23v2.06A7 7 0 0 1 14 18.7v2.06A9 9 0 0 0 14 3.23z"/>
          </svg>
        </button>
        <textarea id="prompt" placeholder="Message GamerAI..." rows="1"></textarea>
        <button type="submit" id="submit">Send</button>
      </div>
      <div class="status" id="status"></div>
      <!-- Collapsible stats panel. Collapsed shows just the running
           token total; tap anywhere on the row to expand and see
           context-window stats, the rolling summary, and a one-line
           explainer of how the coordinator manages history. -->
      <button type="button" class="stats-panel" id="stats-panel"
              aria-expanded="false" aria-controls="stats-expanded" hidden>
        <div class="stats-collapsed">
          <span class="stats-collapsed-text" id="stats-collapsed-text">0 tokens this chat</span>
          <span class="stats-toggle" id="stats-toggle">stats ▴</span>
        </div>
        <div class="stats-expanded" id="stats-expanded" hidden>
          <div class="stats-row" id="stats-row-tokens"></div>
          <div class="stats-row" id="stats-row-context"></div>
          <div class="stats-section" id="stats-section-summary" hidden>
            <div class="stats-label">
              <span>Rolling summary</span>
              <span class="stats-label-status" id="stats-summary-status" hidden>
                <span class="stats-spinner"></span>
                <span>summarizing now…</span>
              </span>
            </div>
            <div class="stats-summary" id="stats-summary-text"></div>
          </div>
          <div class="stats-explainer">
            Older turns are dropped once the context exceeds the
            per-turn token cap. A summary of dropped turns is generated
            in the background and prepended to the model's context on
            subsequent turns, so long threads stay coherent without
            paying full-history prefill on every reply.
          </div>
        </div>
      </button>
    </form>
  </main>
</div>
{% endblock %}

{% block extra_js %}
<script src="/static/marked.min.js"></script>
<script src="/static/purify.min.js"></script>
<script type="module" src="/static/js/chat.js"></script>
{% endblock %}

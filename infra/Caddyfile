# Caddy config for GamerAI MVP.
#
# Caddy terminates TLS. Most paths reverse-proxy to the coordinator;
# the public invite-redemption pages (/invite/<code>) live in the web
# UI container so non-developer invitees see an HTML landing page
# instead of the coordinator's raw JSON. Admin HTML pages
# (/admin/members, /admin/invites in client/web.py) intentionally stay
# off the public hostname — reach them via the SSH tunnel for now,
# until Caddy basic_auth ships.
#
# Bearer-token auth is enforced inside the coordinator itself (see
# shared/auth.py + coordinator/main.py middleware). /health is left
# open by the coordinator for uptime probes.

{$DOMAIN} {
    tls {$EMAIL}
    encode zstd gzip

    # Public download surface for the Windows agent installer +
    # standalone exe. Files are uploaded by CI into /var/www/downloads
    # on the host, which is bind-mounted into the Caddy container at
    # /srv/downloads. See infra/docker-compose.prod.yml.
    handle_path /download/* {
        root * /srv/downloads
        # Standalone agent.exe lives at /download/agent.exe for
        # backwards compatibility with the self-updater (which is
        # hard-coded to that URL on every installed agent). The header
        # below tells browsers to save it under a more descriptive
        # filename so a recruit's Downloads folder doesn't end up
        # with an anonymous "agent.exe."
        @standalone path /agent.exe
        header @standalone Content-Disposition "attachment; filename=\"GamerAI-Agent.exe\""
        file_server browse
    }

    @public_invite path /invite/*
    handle @public_invite {
        reverse_proxy client:8080
    }

    # Chat UI surface. Session-cookie auth gates these on the client
    # side (no admin token leakage, see client/web.py). The chat box,
    # login, logout, and /api/* proxies all live on client:8080.
    # Admin HTML pages (/admin/members, /admin/invites, /dashboard)
    # are gated to role=admin inside the client and therefore safe to
    # expose on the public domain.
    @web_ui path /
    @web_ui_login path /login
    # Bearer-token fallback form on the login page POSTs here (the
    # primary u/p form posts to /login above). Without an explicit
    # route the fallback would fall through to the coordinator
    # default and 401.
    @web_ui_login_token path /login/token
    @web_ui_logout path /logout
    @web_ui_api path /api/*
    @web_ui_dashboard path /dashboard
    @web_ui_admin path /admin/*
    # Per-member account page + the browser-side agent-pair handoff
    # both live on the client container. Without these the requests
    # fall through to the coordinator default and 401 (the coord has
    # no /account or /agent/pair routes).
    @web_ui_account path /account /account/*
    @web_ui_agent_pair path /agent/pair /agent/pair/*
    # Machines page + its schedule PATCH / unpair proxies all live on
    # the client container. Without this they fall through to the
    # coordinator default and 401 (the coord owns /me/machines, but the
    # browser-facing /machines surface is the client's).
    @web_ui_machines path /machines /machines/*
    # Public web signup form. Deliberately NOT at /signup — the
    # coordinator already owns that path for its own public JSON API
    # (POST /signup, used directly by the Windows agent's console
    # signup flow), and that handler expects a JSON body, not this
    # page's form-encoded POST. Reusing /signup here would silently
    # swallow the agent's API calls behind this page instead.
    @web_ui_join path /join
    # Public onboarding pitch + Windows install TL;DR. Reachable
    # while signed in (topbar CTA) and anonymously.
    @web_ui_contribute path /contribute
    # No-install public demo page (task 6.1). Fully client-side (a
    # canned-response library, no backend call) — without this matcher
    # it'd fall through to the coordinator catch-all below, which has
    # no GET /demo route at all.
    @web_ui_demo path /demo
    # Vendored JS (marked + DOMPurify) — referenced by both the chat
    # UI (client:8080) and the ToS page (served by coordinator:8000,
    # which has its own copy). We route to the client since both
    # containers serve identical bytes.
    @web_ui_static path /static/*
    # PWA: service worker must be served from root scope, and the SW
    # source lives in the client. The corresponding FastAPI route in
    # client/app.py adds Service-Worker-Allowed: / so root-scope works.
    # The offline fallback page also lives in the client.
    @web_ui_sw path /sw.js
    @web_ui_offline path /offline
    handle @web_ui {
        reverse_proxy client:8080
    }
    handle @web_ui_login {
        reverse_proxy client:8080
    }
    handle @web_ui_login_token {
        reverse_proxy client:8080
    }
    handle @web_ui_logout {
        reverse_proxy client:8080
    }
    handle @web_ui_api {
        reverse_proxy client:8080
    }
    handle @web_ui_dashboard {
        reverse_proxy client:8080
    }
    handle @web_ui_admin {
        reverse_proxy client:8080
    }
    handle @web_ui_account {
        reverse_proxy client:8080
    }
    handle @web_ui_agent_pair {
        reverse_proxy client:8080
    }
    handle @web_ui_machines {
        reverse_proxy client:8080
    }
    handle @web_ui_join {
        reverse_proxy client:8080
    }
    handle @web_ui_contribute {
        reverse_proxy client:8080
    }
    handle @web_ui_demo {
        reverse_proxy client:8080
    }
    handle @web_ui_static {
        reverse_proxy client:8080
    }
    handle @web_ui_sw {
        reverse_proxy client:8080
    }
    handle @web_ui_offline {
        reverse_proxy client:8080
    }

    handle {
        reverse_proxy coordinator:8000
    }
}

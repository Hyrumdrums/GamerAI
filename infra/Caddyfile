# Caddy config for GamerAI MVP.
#
# Caddy terminates TLS. Most paths reverse-proxy to the coordinator;
# the public invite-redemption pages (/invite/<code>) live in the web
# UI container so non-developer invitees see an HTML landing page
# instead of the coordinator's raw JSON. Admin HTML pages
# (/admin/members, /admin/invites in client/web.py) intentionally stay
# off the public hostname — reach them via the SSH tunnel for now,
# until Caddy basic_auth ships.
#
# Bearer-token auth is enforced inside the coordinator itself (see
# shared/auth.py + coordinator/main.py middleware). /health is left
# open by the coordinator for uptime probes.

{$DOMAIN} {
    tls {$EMAIL}
    encode zstd gzip

    # Public download surface for the Windows agent installer +
    # standalone exe. Files are uploaded by CI into /var/www/downloads
    # on the host, which is bind-mounted into the Caddy container at
    # /srv/downloads. See infra/docker-compose.prod.yml.
    handle_path /download/* {
        root * /srv/downloads
        # Standalone agent.exe lives at /download/agent.exe for
        # backwards compatibility with the self-updater (which is
        # hard-coded to that URL on every installed agent). The header
        # below tells browsers to save it under a more descriptive
        # filename so a recruit's Downloads folder doesn't end up
        # with an anonymous "agent.exe."
        @standalone path /agent.exe
        header @standalone Content-Disposition "attachment; filename=\"GamerAI-Agent.exe\""
        file_server browse
    }

    @public_invite path /invite/*
    handle @public_invite {
        reverse_proxy client:8080
    }

    # Chat UI surface. Session-cookie auth gates these on the client
    # side (no admin token leakage, see client/web.py). The chat box,
    # login, logout, and /api/* proxies all live on client:8080.
    # Admin HTML pages (/admin/members, /admin/invites, /dashboard)
    # are gated to role=admin inside the client and therefore safe to
    # expose on the public domain.
    @web_ui path /
    @web_ui_login path /login
    @web_ui_logout path /logout
    @web_ui_api path /api/*
    @web_ui_dashboard path /dashboard
    @web_ui_admin path /admin/*
    handle @web_ui {
        reverse_proxy client:8080
    }
    handle @web_ui_login {
        reverse_proxy client:8080
    }
    handle @web_ui_logout {
        reverse_proxy client:8080
    }
    handle @web_ui_api {
        reverse_proxy client:8080
    }
    handle @web_ui_dashboard {
        reverse_proxy client:8080
    }
    handle @web_ui_admin {
        reverse_proxy client:8080
    }

    handle {
        reverse_proxy coordinator:8000
    }
}
